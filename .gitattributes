# Keep the new integration layer stable across checkout settings.
* text=auto eol=lf
# Preserve imported bytes, binary packages and recorded evidence exactly.
laboratorios/** -text
distribuciones/** -text
historiales/*.bundle -text
evidencia_integracion/** -text

# Unified diff context lines retain their leading space, including blank lines.
laboratorios/laboratorio_05/diferencias/*.diff -whitespace
laboratorios/laboratorio_06/diferencias/*.diff -whitespace
evidencia_integracion/laboratorio_06_v1.0/**/*.diff -whitespace
# Lab 7: preserve meaningful blank context lines in recorded patches.
laboratorios/laboratorio_07/diferencias/*.diff -whitespace
evidencia_integracion/laboratorio_07_v1.0/**/*.diff -whitespace
# These separately delivered historical Markdown files retain their exact bytes.
docs/estados/ESTADO_DEL_LIBRO_v1.5.2.md -text whitespace=-blank-at-eol
docs/estados/ESTADO_REPOSITORIO_v1.4.1.md -text whitespace=-blank-at-eol
# Lab 8: new recorded diff and separately delivered historical closure.
laboratorios/laboratorio_08/diferencias/*.diff -whitespace
evidencia_integracion/laboratorio_08_v1.0/**/*.diff -whitespace
docs/estados/ESTADO_DEL_LIBRO_v1.6.2.md -text whitespace=-blank-at-eol
docs/estados/ESTADO_REPOSITORIO_v1.5.2.md -text whitespace=-blank-at-eol
evidencia_integracion/cierre_laboratorio_07_confirmado/**/*.md whitespace=-blank-at-eol

# Diferencias didácticas y copias documentales del cierre anterior.
laboratorios/laboratorio_09/diferencias/*.diff -whitespace
docs/estados/ESTADO_DEL_LIBRO_v1.7.4.md -text
docs/estados/ESTADO_REPOSITORIO_v1.6.4.md -text
evidencia_integracion/cierre_laboratorio_08_confirmado/**/*.md whitespace=-blank-at-eol
evidencia_integracion/laboratorio_09_v1.0/**/*.diff -whitespace
evidencia_integracion/laboratorio_09_v1.0/**/*.md whitespace=-blank-at-eol

# Incremento 10 y continuidad exacta posterior al cierre 9.
laboratorios/laboratorio_10/diferencias/*.diff -whitespace
docs/estados/ESTADO_DEL_LIBRO_v1.8.3.md -text
